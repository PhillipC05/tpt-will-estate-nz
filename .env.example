# ─── Server ───────────────────────────────────────────────────────────────────
LISTEN_ADDR=:8080

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Use a secrets manager in production.
DATABASE_URL=postgres://tptnz:changeme@localhost:5432/tptnz?sslmode=require

# ─── RealMe SAML 2.0 ──────────────────────────────────────────────────────────
# Environment: "mts" (test), "ite" (pre-prod), or "production"
REALME_ENVIRONMENT=mts

# SP entity ID registered with DIA — must match your registration exactly.
REALME_ENTITY_ID=https://your-app.example.nz/auth/metadata

# Assertion Consumer Service URL — where RealMe POSTs the SAML response.
REALME_ACS_URL=https://your-app.example.nz/auth/callback

# Paths to the SP's X.509 certificate and private key (PEM). Never commit these.
REALME_CERT_FILE=/certs/sp.crt
REALME_KEY_FILE=/certs/sp.key

# URL to fetch live IdP metadata XML (or use REALME_IDP_METADATA_FILE for a
# locally cached copy — recommended in production to remove network dependency).
REALME_IDP_METADATA_URL=https://mts.realme.govt.nz/saml2/assertion/metadata
# REALME_IDP_METADATA_FILE=/certs/idp-metadata.xml

# ─── BDM Death Notification Webhook ───────────────────────────────────────────
# HMAC-SHA256 secret shared with the BDM notification service.
# Generate with: openssl rand -hex 32
BDM_WEBHOOK_SECRET=

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Space-separated list of allowed origins for the frontend.
CORS_ORIGINS=http://localhost:3000
